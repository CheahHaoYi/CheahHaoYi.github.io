---
import { Layout, Card, Button, Badge, Tag, Callout } from '@cheahhaoyi/site-kit';
import { knowledgeAreas } from '../data/knowledgeAreas';
import { projects } from '../data/projects';
import { portfolioNavLinks } from '../data/navigation';

const featuredProjects = projects.filter((p) => p.featured);
---

<Layout
  title="Hao Yi Cheah — Network Engineer & AI Security"
  description="Network engineer (CISSP, CCNA, RHCSA) moving into AI security. Enterprise routing, hardened Linux administration, and secure AI inference pipelines."
  siteTitle="Hao Yi Cheah"
  siteSubtitle="Network & AI Security"
  navLinks={portfolioNavLinks}
>
  <div class="container stack-lg">
    <!-- Hero Section -->
    <section class="hero-section stack">
      <div class="cluster">
        <Badge pill={true} iosColor="purple" pulse={true}>
          Active // Network & AI Security
        </Badge>
        <Tag pill={true} variant="cert">CISSP</Tag>
        <Tag pill={true} iosColor="blue">CCNA</Tag>
        <Tag pill={true} iosColor="mint">RHCSA</Tag>
        <Tag pill={true} iosColor="indigo">AI Security</Tag>
      </div>

      <div class="hero-content stack-sm">
        <h1 class="hero-title">
          Architecting Resilient Networks &amp; <span class="text-gradient">Hardened AI Systems</span>
        </h1>
        <p class="hero-lead">
          I am a Computer Engineer specializing in enterprise networking, hardened Linux administration,
          and architectural defense-in-depth (CISSP, CCNA, RHCSA) — bridging systems engineering into
          securing next-generation AI pipelines, model guardrails, and real-time telemetry.
        </p>
      </div>

      <div class="cluster hero-actions">
        <Button variant="primary" size="md" pill={true} href="/about">
          <span>Explore Background</span>
          <span class="btn-icon-wrapper">&rarr;</span>
        </Button>
        <Button variant="secondary" size="md" pill={true} href="/projects">
          View Projects
        </Button>
        <Button variant="outline" size="md" pill={true} href="/resume.pdf" target="_blank">
          Download Resume (PDF)
        </Button>
      </div>
    </section>

    <!-- Transition Philosophy Banner -->
    <section class="philosophy-section">
      <Card variant="glass" doubleBezel={true} class="philosophy-card">
        <div class="stack-sm">
          <div class="cluster">
            <span class="pillar-label">// THE CONVERGENCE</span>
            <Badge pill={true} iosColor="indigo">Network &rarr; AI Security</Badge>
          </div>
          <h2 class="section-heading">Why Systems &amp; Network Engineering Anchor AI Security</h2>
          <p>
            AI safety cannot exist in a vacuum above the stack. Defending generative models, autonomous agents,
            and inference workloads requires ground-truth network telemetry, deterministic egress filtering,
            hardened kernel namespaces (SELinux/cgroups), and rigorous zero-trust cryptographic boundaries.
          </p>
        </div>

        <div class="pillars-grid">
          <div class="pillar-item">
            <div class="pillar-number">01</div>
            <h3 class="pillar-title">Packet &amp; Egress Truth</h3>
            <p class="pillar-desc">
              Deterministic firewall rules, deep packet inspection, and mTLS identity layers preventing
              model weight exfiltration and unauthorized side-channel egress.
            </p>
          </div>
          <div class="pillar-item">
            <div class="pillar-number">02</div>
            <h3 class="pillar-title">Hardened Linux Substrates</h3>
            <p class="pillar-desc">
              Least-privilege process boundaries, SELinux policies, and ephemeral container sandboxing
              containing arbitrary code execution and sandbox escapes.
            </p>
          </div>
          <div class="pillar-item">
            <div class="pillar-number">03</div>
            <h3 class="pillar-title">Architectural Governance</h3>
            <p class="pillar-desc">
              Defense-in-depth risk management derived from CISSP domains, ensuring resilient input
              sanitization, model validation, and continuous auditability.
            </p>
          </div>
        </div>
      </Card>
    </section>

    <!-- Certification & Knowledge Portals -->
    <section class="stack">
      <div class="cluster-between">
        <div class="stack-sm">
          <div class="cluster">
            <Badge pill={true} iosColor="purple">Knowledge Hubs</Badge>
            <span class="sub-heading-meta">Multi-Repo Portals</span>
          </div>
          <h2 class="section-title">Certification Study Guides &amp; Architecture Notes</h2>
          <p class="section-desc">
            Deep technical documentation, lab topologies, and domain notes published across dedicated sub-sites.
          </p>
        </div>
      </div>

      <div class="grid-responsive">
        {knowledgeAreas.map((area) => (
          <Card
            variant="glass"
            doubleBezel={true}
            title={area.name}
            description={area.description}
            badge={area.badge}
            badgeVariant="cert"
            href={area.path}
            tags={area.tags}
          />
        ))}
      </div>
    </section>

    <!-- Featured Projects Showcase -->
    <section class="stack">
      <div class="cluster-between">
        <div class="stack-sm">
          <div class="cluster">
            <Badge pill={true} iosColor="blue">Showcase</Badge>
            <span class="sub-heading-meta">Hardware, Firmware &amp; Software</span>
          </div>
          <h2 class="section-title">Featured Projects</h2>
          <p class="section-desc">
            Highlighted engineering initiatives spanning AI guardrails, CPU design, and edge IoT devices.
          </p>
        </div>
        <Button variant="ghost" size="sm" pill={true} href="/projects">
          <span>View All Projects</span>
          <span class="btn-icon-wrapper">&rarr;</span>
        </Button>
      </div>

      <div class="grid-responsive">
        {featuredProjects.map((project) => (
          <Card
            variant="tonal"
            title={project.name}
            description={project.description}
            badge={project.badge}
            date={project.date}
            href={project.repoUrl || project.demoUrl || project.detailPath}
            tags={project.tags}
          />
        ))}
      </div>
    </section>

    <!-- Contact & Collaboration Callout -->
    <section class="cta-section">
      <Callout variant="tip" title="Open for Technical Exchange & Collaboration">
        Interested in discussing enterprise networking topologies, Linux kernel hardening, or AI security
        guardrails? Feel free to reach out via <a href="/contact">the contact page</a> or direct email at{' '}
        <a href="mailto:hellohaoyicheah@gmail.com"><code>hellohaoyicheah@gmail.com</code></a>.
      </Callout>
    </section>
  </div>
</Layout>

<style>
  /* Hero Typography & Presentation */
  .hero-section {
    padding: var(--space-6) 0 var(--space-4);
  }

  .hero-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text-primary);
    max-width: 900px;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-4xl);
    }
  }

  .text-gradient {
    color: var(--color-accent-primary);
  }

  .hero-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 820px;
  }

  .hero-actions {
    margin-top: var(--space-2);
  }

  /* Philosophy Banner */
  .pillar-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-primary);
    letter-spacing: var(--tracking-wider);
  }

  .section-heading {
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-tight);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .pillars-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pillar-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .pillar-number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-primary);
  }

  .pillar-title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .pillar-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  /* Section Typography */
  .section-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
  }

  .section-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 700px;
  }

  .sub-heading-meta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }
</style>
