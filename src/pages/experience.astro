---
import { Layout, Card, Button, Badge, Tag, Callout } from '@cheahhaoyi/site-kit';
import { experienceItems } from '../data/experience';
import { portfolioNavLinks } from '../data/navigation';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Experience' },
];
---

<Layout
  title="Work Experience & Timeline — Hao Yi Cheah"
  description="Chronological work history and engineering internships at Espressif Systems across Czechia and Singapore."
  breadcrumbs={breadcrumbs}
  siteTitle="Hao Yi Cheah"
  siteSubtitle="Network & AI Security"
  navLinks={portfolioNavLinks}
>
  <div class="container stack-lg">
    <!-- Header -->
    <header class="stack-sm">
      <div class="cluster">
        <Badge pill={true} iosColor="purple" pulse={true}>Career Timeline</Badge>
        <span class="meta-label">Chronological History</span>
      </div>
      <h1 class="page-title">Work Experience &amp; Engineering Timeline</h1>
      <p class="page-lead">
        Hands-on software and systems engineering experience spanning low-level microcontroller firmware,
        board support packages, and wireless networking protocol validation.
      </p>
    </header>

    <!-- Timeline Container -->
    <section class="timeline-container stack-lg">
      {experienceItems.map((item, index) => (
        <div class="timeline-entry">
          <div class="timeline-marker">
            <span class="timeline-node">{String(index + 1).padStart(2, '0')}</span>
            <div class="timeline-line"></div>
          </div>

          <div class="timeline-content">
            <Card variant="glass" doubleBezel={true} class="timeline-card">
              <div class="stack-sm">
                <div class="cluster-between">
                  <div>
                    <span class="company-badge">{item.company}</span>
                    <h2 class="role-title">{item.role}</h2>
                  </div>
                  <div class="cluster">
                    <Badge pill={true} iosColor="purple">{item.period}</Badge>
                    <Tag pill={true} size="sm">{item.location}</Tag>
                  </div>
                </div>

                <p class="role-summary">{item.summary}</p>

                <div class="responsibilities-block">
                  <span class="block-label">Key Responsibilities &amp; Impact:</span>
                  <ul class="resp-list">
                    {item.responsibilities.map((resp) => (
                      <li>{resp}</li>
                    ))}
                  </ul>
                </div>

                <div class="skills-block">
                  <span class="block-label">Technologies &amp; Competencies:</span>
                  <div class="cluster">
                    {item.skills.map((skill) => (
                      <Tag pill={true} size="sm" iosColor="purple">{skill}</Tag>
                    ))}
                  </div>
                </div>
              </div>
            </Card>
          </div>
        </div>
      ))}
    </section>

    <!-- Resume Download Callout -->
    <section>
      <Callout variant="tip" title="Looking for a Full Chronological CV?">
        Download my verified, metadata-sanitized resume:
        <div class="cta-button-wrap">
          <Button variant="primary" size="md" pill={true} href="/resume.pdf" target="_blank">
            <span>Download Official Resume (PDF)</span>
            <span class="btn-icon-wrapper">&rarr;</span>
          </Button>
        </div>
      </Callout>
    </section>
  </div>
</Layout>

<style>
  .page-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: var(--text-4xl);
    }
  }

  .page-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 800px;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  /* Timeline Architecture */
  .timeline-container {
    position: relative;
    padding-left: var(--space-2);
  }

  .timeline-entry {
    display: flex;
    gap: var(--space-4);
    position: relative;
  }

  @media (min-width: 768px) {
    .timeline-entry {
      gap: var(--space-6);
    }
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .timeline-node {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background-color: var(--color-accent-subtle);
    border: 2px solid var(--color-accent-primary);
    color: var(--color-accent-primary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    box-shadow: 0 0 12px rgba(124, 58, 237, 0.25);
    z-index: 2;
  }

  .timeline-line {
    flex: 1;
    width: 2px;
    background-color: var(--color-border);
    margin-top: var(--space-2);
    min-height: 40px;
  }

  .timeline-content {
    flex: 1;
    padding-bottom: var(--space-6);
  }

  .company-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-primary);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .role-title {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: var(--space-1) 0 0;
  }

  .role-summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .block-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--space-1-5);
  }

  .resp-list {
    margin: 0;
    padding-left: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .cta-button-wrap {
    margin-top: var(--space-3);
  }
</style>
