---
import { Layout, Card, Badge, Tag, Callout, Table, Prose } from '@cheahhaoyi/site-kit';
import { educationItems } from '../data/education';
import { portfolioNavLinks } from '../data/navigation';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About' },
];

const certMatrixHeaders = ['Certification / Domain', 'Focus Area', 'What do I know'];
const certMatrixRows = [
  [
    'CISSP ((ISC)²)',
    'Enterprise Security Governance',
    'Defense-in-depth architecture, access controls, cryptography, and ML risk governance.',
  ],
  [
    'CCNA (Cisco)',
    'Routing, Switching & IP Connectivity',
    'Network telemetry, deterministic egress filtering, packet inspection, and micro-segmentation.',
  ],
  [
    'CNCDP',
    'Network Cabling Design',
    'Designing and implementing robust data network cabling infrastructures',
  ],
  [
    'RHCSA (Red Hat) - In Progress',
    'Enterprise Linux Systems & Security',
    'Hardened host OS, SELinux least-privilege containment, and secure container sandboxing.',
  ],
  [
    'OSCP (Offsec) - In Progress',
    'Penetration Testing & Ethical Hacking',
    'Exploiting real-world vulnerabilities across networks, web applications, and cloud environments.',
  ]
];
---

<Layout
  title="About Hao Yi Cheah — Background & Technical Philosophy"
  description="Computer engineer and network security practitioner moving into AI security. Background in enterprise routing, Linux administration, and LLM defense."
  breadcrumbs={breadcrumbs}
  siteTitle="Hao Yi Cheah"
  siteSubtitle="Network & AI Security"
  navLinks={portfolioNavLinks}
>
  <div class="container stack-lg">
    <!-- Header -->
    <header class="stack-sm">
      <div class="cluster">
        <Badge pill={true} iosColor="purple" pulse={true}>Background &amp; Vision</Badge>
        <Tag pill={true} variant="cert">CISSP</Tag>
        <Tag pill={true} iosColor="blue">CCNA</Tag>
        <Tag pill={true} iosColor="mint">RHCSA</Tag>
        <Tag pill={true} iosColor="orange">System Design</Tag>
        <Tag pill={true} iosColor="green">Leetcode</Tag>
      </div>
      <h1 class="page-title">About Me &amp; Technical Philosophy</h1>
      <p class="page-lead">
        I am a Computer Engineer with practical experience across various domains: 
      </p>
      <p>
        Hardware Design - Network Design - Security Design - System Design
      </p>
    </header>

    <!-- Narrative Section: Network Engineer to AI Security -->
    <section class="stack">
      <Card variant="glass" doubleBezel={true}>
        <Prose>
          <h2>The Journey: From Embedded Silicon to AI Infrastructure Security</h2>
          <p>
            My engineering background spans low-level systems and enterprise infrastructure: from developing C/C++ Board Support Packages (BSP) and network protocols at Espressif Systems to commissioning high-availability data centers, NFVI virtualization, and L2/L3 network security at Huawei.
          </p>
          <p>
            As autonomous AI agents and local inference models deploy into production, threat surfaces expand beyond simple prompt injections to host compromise, privilege escalation, and supply chain vulnerabilities. AI security cannot rely solely on prompt alignment or soft guardrails.
          </p>
        </Prose>
      </Card>
    </section>

    <!-- How the Certifications Fit Together -->
    <section class="stack">
      <div class="stack-sm">
        <div class="cluster">
          <Badge pill={true} iosColor="indigo">Synergy Matrix</Badge>
          <span class="meta-label">Architectural Defense</span>
        </div>
        <h2 class="section-title">My certifications</h2>
        <p class="section-desc">
          Each certification and discipline represents a critical layer in the security defense-in-depth model.
        </p>
      </div>

      <Table
        headers={certMatrixHeaders}
        rows={certMatrixRows}
        caption="Security Domain & AI Defense Cross-Functional Matrix"
        striped={true}
      />
    </section>

    <!-- Academic Background -->
    <section class="stack">
      <div class="stack-sm">
        <div class="cluster">
          <Badge pill={true} iosColor="mint">Education</Badge>
          <span class="meta-label">National University of Singapore &amp; DTU</span>
        </div>
        <h2 class="section-title">Academic Background</h2>
        <p class="section-desc">
          Rigorous foundational education spanning computer engineering, robotics, and management.
        </p>
      </div>

      <div class="stack">
        {educationItems.map((item) => (
          <Card variant="tonal" class="edu-card">
            <div class="stack-sm">
              <div class="cluster-between">
                <div>
                  <h3 class="edu-institution">{item.institution}</h3>
                  <p class="edu-degree">{item.degree}</p>
                </div>
                <div class="cluster">
                  <Badge pill={true} iosColor="purple">{item.period}</Badge>
                  <Tag pill={true}>{item.location}</Tag>
                </div>
              </div>

              <p class="edu-summary">{item.summary}</p>

              <div class="edu-details-grid">
                <div>
                  <span class="edu-subheading">Key Highlights &amp; Tracks:</span>
                  <ul class="edu-list">
                    {item.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <span class="edu-subheading">Selected Coursework:</span>
                  <div class="cluster coursework-tags">
                    {item.coursework.map((course) => (
                      <Tag pill={true} size="sm">{course}</Tag>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </section>

    <!-- Quick Navigation / Callout -->
    <section>
      <Callout variant="info" title="Putting knowledge to action!">
        Check out the <a href="/projects">Projects Showcase</a> or
        explore the <a href="/experience">Work History &amp; Experience Timeline</a>.
      </Callout>
    </section>
  </div>
</Layout>

<style>
  .page-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: var(--text-4xl);
    }
  }

  .page-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 800px;
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
  }

  .section-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  /* Education Cards */
  .edu-institution {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .edu-degree {
    font-size: var(--text-sm);
    color: var(--color-accent-primary);
    font-weight: var(--font-weight-medium);
    margin: 0;
  }

  .edu-summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .edu-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .edu-details-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .edu-subheading {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .edu-list {
    margin: 0;
    padding-left: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .coursework-tags {
    gap: var(--space-1-5);
  }
</style>
